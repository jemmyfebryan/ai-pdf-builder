% ai-pdf-builder - Research Report Template
% Professional investment research aesthetic
% Modern design for crypto/asset research reports

\documentclass[11pt,a4paper]{article}

% Essential Packages
\usepackage{lmodern}
\usepackage{amssymb,amsmath}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}

% Professional fonts
\usepackage{helvet}
\renewcommand{\familydefault}{\sfdefault}

% Geometry
\usepackage[margin=1.2in, top=1.5in, bottom=1.2in]{geometry}
\usepackage{setspace}
\setstretch{1.15}

% Graphics and Colors
\usepackage{graphicx}
\usepackage[table]{xcolor}
\usepackage{tikz}
\usetikzlibrary{calc}

% Research Color Palette - Professional Dark Blue
\definecolor{brandblue}{RGB}{10, 25, 47}
\definecolor{brandaccent}{RGB}{100, 255, 218}
\definecolor{bglight}{RGB}{248, 249, 250}
\definecolor{textmain}{RGB}{45, 55, 72}
\definecolor{textlight}{RGB}{113, 128, 150}

% Tables
\usepackage{longtable,booktabs,array}
\usepackage{multirow,tabularx}
\usepackage{tcolorbox}
\tcbuselibrary{skins}
\renewcommand{\arraystretch}{1.2}

% Links
\usepackage{hyperref}
\hypersetup{
    unicode=true,
    colorlinks=true,
    linkcolor=brandblue,
    citecolor=brandblue,
    urlcolor=brandblue,
    breaklinks=true,
    pdfborder={0 0 0}
}
\urlstyle{same}

% Headers and Footers
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\small\color{textlight}\textbf{$if(company)$$company$$endif$}}
\fancyfoot[R]{\small\color{textlight}REFER TO IMPORTANT DISCLOSURE IN THE LAST PAGE OF THIS REPORT}

% Section Styling
\usepackage{titlesec}

\titleformat{\section}
    {\Large\bfseries\color{brandblue}}
    {}
    {0pt}
    {}
    [\vspace{-0.3em}{\color{textlight}\rule{\textwidth}{0.5pt}}]
    \titlespacing*{\section}{0pt}{1.5em}{1em}

\titleformat{\subsection}
    {\large\bfseries\color{textmain}}
    {}
    {0pt}
    {}
    \titlespacing*{\subsection}{0pt}{1.2em}{0.6em}

% Lists
\usepackage{enumitem}
\setlist{noitemsep, topsep=6pt, leftmargin=1.5em}
\setlist[itemize,1]{label=\textcolor{brandblue}{\textbullet}}
\setlist[itemize,2]{label=\textcolor{textlight}{\textendash}}

% Pandoc compatibility
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Additional includes
$if(header-includes)$
$header-includes$
$endif$

\begin{document}
\color{textmain}

% Title Banner
\begin{center}
    \textcolor{textlight}{\small $if(asset_ticker)$$asset_ticker$$endif$$if(asset_type)$ $asset_type$$endif$$if(category)$ | $category$$endif$} \\
    \vspace{0.3cm}
    \textcolor{brandblue}{\huge \textbf{$if(company)$$company$$endif$}} \\
    \textcolor{brandblue}{\Large \textbf{RESEARCH}} \\
    \vspace{0.6cm}
    \begin{tcolorbox}[enhanced, colback=brandblue, colframe=brandblue, arc=1mm,
                      halign=center, valign=center, top=3mm, bottom=3mm]
        \textcolor{white}{\Huge \textbf{\MakeUppercase{$if(title)$$title$$endif$}}} \\
        $if(subtitle)$
        \vspace{0.1cm}
        \textcolor{brandaccent}{\large \MakeUppercase{$subtitle$}}
        $endif$
    \end{tcolorbox}
\end{center}

\vspace{0.4cm}

% Metadata and Asset Details
\noindent
\begin{minipage}[t]{0.35\textwidth}
    \vspace{0pt}
    $if(date)$
    \textbf{\large $date$} \\
    $endif$
    $if(report_type)$
    \textbf{\large $report_type$}
    $endif$
\end{minipage}%
\begin{minipage}[t]{0.65\textwidth}
    \vspace{0pt}
    $if(asset_details)$
    \begin{tcolorbox}[enhanced, colback=white, colframe=textlight!30, arc=1mm, boxrule=0.5pt]
        \renewcommand{\arraystretch}{1.2}
        \begin{tabularx}{\textwidth}{X r}
            \multicolumn{2}{l}{\textbf{Asset Details}} \\
            \hline
            $asset_details$
        \end{tabularx}
    \end{tcolorbox}
    $endif$
\end{minipage}

\vspace{0.6cm}

% Main Content
$body$

% Disclaimer Page
\newpage
\fancyfoot[R]{}
\vspace*{3cm}

\begin{center}
    \textcolor{brandblue}{\Huge \textbf{$if(company)$$company$$endif$ RESEARCH}} \\
    \vspace{0.8cm}
    \textbf{COPYRIGHT © $if(year)$$year$$else$2024$endif$ BY $if(company)$$company$$endif$ ALL RIGHTS RESERVED.} \\
    \vspace{0.3cm}
    \textcolor{textmain}{\small No Portion of This Content May be Reproduced in Any Form Without the Prior Written Permission from $if(company)$$company$$endif$.}
\end{center}

\vspace{2cm}

\noindent \textcolor{brandblue}{\Large \textbf{DISCLAIMERS}}
\vspace{0.3cm}

{\color{textmain}\small
$if(disclaimer)$
$disclaimer$
$else$
This research is based on information obtained from sources believed to be reliable, but we do not make any representation or warranty nor accept any responsibility or liability as to its accuracy, completeness or correctness. Opinions expressed are subject to change without notice. This document is prepared for general circulation. Any recommendations contained in this document does not have regard to the specific investment objectives, financial situation and the particular needs of any specific addressee.

This document is not and should not be construed as an offer or a solicitation of an offer to purchase or subscribe or sell any securities. This research and its content are for internal research and should not be construed as investment reference. The recommendations provided are general guidelines based on market trends and risk management principles.
$endif$
}

\end{document}
